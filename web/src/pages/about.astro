---
import Base from "../layouts/Base.astro";
import { getCollection, renderEntry } from "@app/lib/content-fs";

const locale = "en";
const [page] = await getCollection("pages", ({ data }) => data.translationKey === "about" && data.locale === locale);
const contentHtml = page ? await renderEntry(page) : null;
---

<Base title={page?.data.title ?? "About"} description={page?.data.description} locale={locale} alternatePath="/fr/a-propos">
  <article class="prose">
    {contentHtml ? <Fragment set:html={contentHtml} /> : <p>An about page hasn't been written yet.</p>}
  </article>
</Base>
