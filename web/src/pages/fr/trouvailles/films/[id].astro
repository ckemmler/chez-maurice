---
import MovieDetail from "../../../../components/MovieDetail.astro";
import { getCollection } from "@app/lib/content-fs";
import { isPublic } from "../../../../lib/flags";
import { stripLocalePrefix } from "../../../../i18n/utils";

export const prerender = process.env.WEB_SSR !== "1";

export async function getStaticPaths() {
  const movies = await getCollection("movies", ({ data }) => data.locale === "fr" && isPublic(data));
  return movies.map((movie) => ({
    params: { id: stripLocalePrefix(movie.id) },
    props: { movie },
  }));
}

let __props = Astro.props;
if (!__props.movie) {
  // SSR: look the entry up here rather than through getStaticPaths,
  // which describes the public static build — the owner sees their
  // drafts in their own garden.
  const found = (await getCollection("movies", ({ data }) => data.locale === "fr" && (Astro.locals.owner || isPublic(data))))
    .find((e) => stripLocalePrefix(e.id) === Astro.params.id);
  __props = found ? { movie: found } : {};
}
const { movie } = __props;
if (!movie) return new Response("Not found", { status: 404 });
---
<MovieDetail movie={movie} locale="fr" />
