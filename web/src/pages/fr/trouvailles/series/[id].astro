---
import SeriesDetail from "../../../../components/SeriesDetail.astro";
import { getCollection } from "@app/lib/content-fs";
import { isPublic } from "../../../../lib/flags";
import { stripLocalePrefix } from "../../../../i18n/utils";

export const prerender = process.env.WEB_SSR !== "1";

export async function getStaticPaths() {
  const allSeries = await getCollection("series", ({ data }) => data.locale === "fr" && isPublic(data) && !data.show);
  return allSeries.map((s) => ({
    params: { id: stripLocalePrefix(s.id) },
    props: { series: s },
  }));
}

let __props = Astro.props;
if (!__props.series) {
  // SSR: look the entry up here rather than through getStaticPaths,
  // which describes the public static build — the owner sees their
  // drafts in their own garden.
  const found = (await getCollection("series", ({ data }) => data.locale === "fr" && (Astro.locals.owner || isPublic(data)) && !data.show))
    .find((e) => stripLocalePrefix(e.id) === Astro.params.id);
  __props = found ? { series: found } : {};
}
const { series } = __props;
if (!series) return new Response("Not found", { status: 404 });
---
<SeriesDetail series={series} locale="fr" />
