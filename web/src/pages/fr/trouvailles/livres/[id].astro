---
import BookDetail from "../../../../components/BookDetail.astro";
import { getCollection } from "@app/lib/content-fs";
import { isPublic } from "../../../../lib/flags";
import { stripLocalePrefix } from "../../../../i18n/utils";

export const prerender = process.env.WEB_SSR !== "1";

export async function getStaticPaths() {
  const books = await getCollection("books", ({ data }) => data.locale === "fr" && isPublic(data));
  return books.map((book) => ({
    params: { id: stripLocalePrefix(book.id) },
    props: { book },
  }));
}

let __props = Astro.props;
if (!__props.book) {
  // SSR: look the entry up here rather than through getStaticPaths,
  // which describes the public static build — the owner sees their
  // drafts in their own garden.
  const found = (await getCollection("books", ({ data }) => data.locale === "fr" && (Astro.locals.owner || isPublic(data))))
    .find((e) => stripLocalePrefix(e.id) === Astro.params.id);
  __props = found ? { book: found } : {};
}
const { book } = __props;
if (!book) return new Response("Not found", { status: 404 });
---
<BookDetail book={book} locale="fr" />
