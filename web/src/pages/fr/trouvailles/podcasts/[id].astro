---
import PodcastDetail from "../../../../components/PodcastDetail.astro";
import { getCollection } from "@app/lib/content-fs";
import { isPublic } from "../../../../lib/flags";
import { stripLocalePrefix } from "../../../../i18n/utils";

export const prerender = process.env.WEB_SSR !== "1";

export async function getStaticPaths() {
  const podcasts = await getCollection("podcasts", ({ data }) => data.locale === "fr" && isPublic(data) && !data.show);
  return podcasts.map((podcast) => ({
    params: { id: stripLocalePrefix(podcast.id) },
    props: { podcast },
  }));
}

let __props = Astro.props;
if (!__props.podcast) {
  // SSR: look the entry up here rather than through getStaticPaths,
  // which describes the public static build — the owner sees their
  // drafts in their own garden.
  const found = (await getCollection("podcasts", ({ data }) => data.locale === "fr" && (Astro.locals.owner || isPublic(data)) && !data.show))
    .find((e) => stripLocalePrefix(e.id) === Astro.params.id);
  __props = found ? { podcast: found } : {};
}
const { podcast } = __props;
if (!podcast) return new Response("Not found", { status: 404 });
---
<PodcastDetail podcast={podcast} locale="fr" />
