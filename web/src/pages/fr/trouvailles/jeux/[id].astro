---
import GameDetail from "../../../../components/GameDetail.astro";
import { getCollection } from "@app/lib/content-fs";
import { isPublic } from "../../../../lib/flags";
import { stripLocalePrefix } from "../../../../i18n/utils";

export const prerender = process.env.WEB_SSR !== "1";

export async function getStaticPaths() {
  const games = await getCollection("games", ({ data }) => data.locale === "fr" && isPublic(data));
  return games.map((game) => ({
    params: { id: stripLocalePrefix(game.id) },
    props: { game },
  }));
}

let __props = Astro.props;
if (!__props.game) {
  // SSR: look the entry up here rather than through getStaticPaths,
  // which describes the public static build — the owner sees their
  // drafts in their own garden.
  const found = (await getCollection("games", ({ data }) => data.locale === "fr" && (Astro.locals.owner || isPublic(data))))
    .find((e) => stripLocalePrefix(e.id) === Astro.params.id);
  __props = found ? { game: found } : {};
}
const { game } = __props;
if (!game) return new Response("Not found", { status: 404 });
---
<GameDetail game={game} locale="fr" />
