---
import GameDetail from "../../../../components/GameDetail.astro";
import { getCollection } from "astro:content";
import { isPublic } from "../../../../lib/flags";
import { stripLocalePrefix } from "../../../../i18n/utils";

export const prerender = process.env.WEB_SSR !== "1";

export async function getStaticPaths() {
  const games = await getCollection("games", ({ data }) => data.locale === "fr" && (import.meta.env.DEV || isPublic(data)));
  return games.map((game) => ({
    params: { id: stripLocalePrefix(game.id) },
    props: { game },
  }));
}

let __props = Astro.props;
if (!__props.game) {
  __props = (await getStaticPaths()).find((e) => e.params.id === Astro.params.id)?.props ?? {};
}
const { game } = __props;
if (!game) return new Response("Not found", { status: 404 });
---
<GameDetail game={game} locale="fr" />
