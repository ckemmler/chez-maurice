---
import ArticleDetail from "../../../components/ArticleDetail.astro";
import { getCollection } from "@app/lib/content-fs";
import { isPublic } from "../../../lib/flags";
import { stripLocalePrefix } from "../../../i18n/utils";

export const prerender = process.env.WEB_SSR !== "1";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => isPublic(data));
  return articles.map((article) => ({
    params: { id: stripLocalePrefix(article.id) },
    props: { article },
  }));
}

let __props = Astro.props;
if (!__props.article) {
  // SSR: look the entry up here rather than through getStaticPaths,
  // which describes the public static build — the owner sees their
  // drafts in their own garden.
  const found = (await getCollection("articles", ({ data }) => (Astro.locals.owner || isPublic(data))))
    .find((e) => stripLocalePrefix(e.id) === Astro.params.id);
  __props = found ? { article: found } : {};
}
const { article } = __props;
if (!article) return new Response("Not found", { status: 404 });
---
<ArticleDetail article={article} locale={article.data.locale} />
