---
import PersonDetail from "../../../components/PersonDetail.astro";
import { getCollection } from "@app/lib/content-fs";
import { isPublic } from "../../../lib/flags";
import { stripLocalePrefix } from "../../../i18n/utils";

export const prerender = process.env.WEB_SSR !== "1";

export async function getStaticPaths() {
  const people = await getCollection("people", ({ data }) => data.locale === "en" && isPublic(data));
  return people.map((person) => ({
    params: { id: stripLocalePrefix(person.id) },
    props: { person },
  }));
}

let __props = Astro.props;
if (!__props.person) {
  // SSR: look the entry up here rather than through getStaticPaths,
  // which describes the public static build — the owner sees their
  // drafts in their own garden.
  const found = (await getCollection("people", ({ data }) => data.locale === "en" && (Astro.locals.owner || isPublic(data))))
    .find((e) => stripLocalePrefix(e.id) === Astro.params.id);
  __props = found ? { person: found } : {};
}
const { person } = __props;
if (!person) return new Response("Not found", { status: 404 });
---
<PersonDetail person={person} locale="en" />
