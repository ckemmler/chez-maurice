---
import BlogPost from "../../components/BlogPost.astro";
import { getCollection } from "@app/lib/content-fs";
import { isPublic } from "../../lib/flags";
import { stripLocalePrefix } from "../../i18n/utils";

export const prerender = process.env.WEB_SSR !== "1";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => data.locale === "en" && isPublic(data));
  return posts.map((post) => ({
    params: { id: stripLocalePrefix(post.id) },
    props: { post },
  }));
}

let __props = Astro.props;
if (!__props.post) {
  // SSR: look the entry up here rather than through getStaticPaths,
  // which describes the public static build — the owner sees their
  // drafts in their own garden.
  const found = (await getCollection("blog", ({ data }) => data.locale === "en" && (Astro.locals.owner || isPublic(data))))
    .find((e) => stripLocalePrefix(e.id) === Astro.params.id);
  __props = found ? { post: found } : {};
}
const { post } = __props;
if (!post) return new Response("Not found", { status: 404 });
---
<BlogPost post={post} locale="en" />
