---
import EssayDetail from "../../components/EssayDetail.astro";
import { getCollection } from "@app/lib/content-fs";
import { isPublic } from "../../lib/flags";
import { stripLocalePrefix } from "../../i18n/utils";

export const prerender = process.env.WEB_SSR !== "1";

export async function getStaticPaths() {
  const essays = await getCollection("essays", ({ data }) => data.locale === "en" && isPublic(data));
  return essays.map((essay) => ({
    params: { id: stripLocalePrefix(essay.id) },
    props: { essay },
  }));
}

let __props = Astro.props;
if (!__props.essay) {
  // SSR: look the entry up here rather than through getStaticPaths,
  // which describes the public static build — the owner sees their
  // drafts in their own garden.
  const found = (await getCollection("essays", ({ data }) => data.locale === "en" && (Astro.locals.owner || isPublic(data))))
    .find((e) => stripLocalePrefix(e.id) === Astro.params.id);
  __props = found ? { essay: found } : {};
}
const { essay } = __props;
if (!essay) return new Response("Not found", { status: 404 });
---
<EssayDetail essay={essay} locale="en" />
