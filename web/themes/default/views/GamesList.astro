---
import Base from "@app/layouts/Base.astro";
import type { Locale } from "@app/i18n/config";
import { t, resourceItemPath, formatShortDate, stripLocalePrefix } from "@app/i18n/utils";
import { getCollection } from "astro:content";
import { isPublic } from "@app/lib/flags";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;

function isDraft(entry: { data: { flags?: string[] } }) {
  return !isPublic(entry.data);
}

const games = await getCollection("games", ({ data }) => (import.meta.env.DEV || isPublic(data)) && data.locale === locale)
  .then((m) => m.sort((a, b) => b.data.date_played.valueOf() - a.data.date_played.valueOf()));

const fiches = await getCollection("fiches", ({ data }) => data.locale === locale && data.resource_collection === "games");
const ficheByResourceId = new Map(fiches.map((f) => [f.data.resource_id, f]));
const gameSlugs = new Set(games.map((m) => stripLocalePrefix(m.id)));
const orphanFiches = fiches.filter((f) => !gameSlugs.has(f.data.resource_id));
---

<Base title={t(locale, "games.title")} description={t(locale, "games.description")} locale={locale}>
  <article class="prose">
    <h1>{t(locale, "games.title")}</h1>
    <p class="text-muted">{t(locale, "games.description")}</p>
    <p class="draft-empty-notice text-muted">All items on this page are drafts.</p>

    {games.length > 0 ? (
      <ul class="game-list">
        {games.map((game) => {
          const fiche = ficheByResourceId.get(stripLocalePrefix(game.id));
          return (
            <li data-draft={isDraft(game) ? "true" : undefined}>
              <a href={resourceItemPath(locale, "games", game.id)} class="game-title">{game.data.title}</a>{!isDraft(game) && <span class="public-dot">•</span>}
              {fiche && <a href={`${locale === "fr" ? "/fr" : ""}/fiches/${fiche.id.replace(/\/(en|fr)\//, "/")}`} class="fiche-link">fiche</a>}
              {game.data.developer && <span class="text-muted"> — {game.data.developer}</span>}
              {game.data.year && <span class="text-muted text-sm"> ({game.data.year})</span>}
              {game.data.platforms?.length > 0 && <span class="text-muted text-sm"> · {game.data.platforms.join(", ")}</span>}
              <span class="text-muted text-sm"> · {formatShortDate(game.data.date_played, locale)}</span>
              {game.data.rating && (
                <span class="rating">{"★".repeat(game.data.rating)}{"☆".repeat(5 - game.data.rating)}</span>
              )}
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="text-muted">{t(locale, "games.noGamesYet")}</p>
    )}

    {orphanFiches.length > 0 && (
      <section>
        <h2>Fiches</h2>
        <ul class="game-list">
          {orphanFiches.map((fiche) => (
            <li>
              <a href={`${locale === "fr" ? "/fr" : ""}/fiches/${fiche.id.replace(/\/(en|fr)\//, "/")}`} class="fiche-link">{fiche.data.title}</a>
              <span class="text-muted text-sm"> · {formatShortDate(fiche.data.date, locale)}</span>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</Base>

<style>
  .game-list { list-style: none; padding: 0; }
  .game-list li { margin-bottom: var(--spacing-md); font-size: 1.05rem; }
  .game-title { font-size: 1.35rem; }
  .rating { display: inline-block; margin-left: var(--spacing-sm); color: #d4a017; letter-spacing: 1px; }
  :global(.prose .fiche-link) { color: #7c3aed; font-size: 0.9em; }
  :global(.dark .prose .fiche-link) { color: #a78bfa; }
</style>
