---
import Base from "@app/layouts/Base.astro";
import type { Locale } from "@app/i18n/config";
import { t, resourceItemPath, formatShortDate, stripLocalePrefix } from "@app/i18n/utils";
import { getCollection } from "@app/lib/content-fs";
import { isPublic } from "@app/lib/flags";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;

function isDraft(entry: { data: { flags?: string[] } }) {
  return !isPublic(entry.data);
}

const albums = await getCollection("music", ({ data }) => (Astro.locals.owner || isPublic(data)) && data.locale === locale)
  .then((m) => m.sort((a, b) => b.data.date_listened.valueOf() - a.data.date_listened.valueOf()));

const fiches = await getCollection("fiches", ({ data }) => data.locale === locale && data.resource_collection === "music");
const ficheByResourceId = new Map(fiches.map((f) => [f.data.resource_id, f]));
const albumSlugs = new Set(albums.map((m) => stripLocalePrefix(m.id)));
const orphanFiches = fiches.filter((f) => !albumSlugs.has(f.data.resource_id));
---

<Base title={t(locale, "music.title")} description={t(locale, "music.description")} locale={locale}>
  <article class="prose">
    <h1>{t(locale, "music.title")}</h1>
    <p class="text-muted">{t(locale, "music.description")}</p>
    <p class="draft-empty-notice text-muted">All items on this page are drafts.</p>

    {albums.length > 0 ? (
      <ul class="album-list">
        {albums.map((album) => {
          const fiche = ficheByResourceId.get(stripLocalePrefix(album.id));
          return (
            <li data-draft={isDraft(album) ? "true" : undefined}>
              <a href={resourceItemPath(locale, "music", album.id)} class="album-title">{album.data.title}</a>{!isDraft(album) && <span class="public-dot">•</span>}
              {fiche && <a href={`${locale === "fr" ? "/fr" : ""}/fiches/${fiche.id.replace(/\/(en|fr)\//, "/")}`} class="fiche-link">fiche</a>}
              {album.data.artist && <span class="text-muted"> — {album.data.artist}</span>}
              {album.data.year && <span class="text-muted text-sm"> ({album.data.year})</span>}
              <span class="text-muted text-sm"> · {formatShortDate(album.data.date_listened, locale)}</span>
              {album.data.rating && (
                <span class="rating">{"★".repeat(album.data.rating)}{"☆".repeat(5 - album.data.rating)}</span>
              )}
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="text-muted">{t(locale, "music.noMusicYet")}</p>
    )}

    {orphanFiches.length > 0 && (
      <section>
        <h2>Fiches</h2>
        <ul class="album-list">
          {orphanFiches.map((fiche) => (
            <li>
              <a href={`${locale === "fr" ? "/fr" : ""}/fiches/${fiche.id.replace(/\/(en|fr)\//, "/")}`} class="fiche-link">{fiche.data.title}</a>
              <span class="text-muted text-sm"> · {formatShortDate(fiche.data.date, locale)}</span>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</Base>

<style>
  .album-list { list-style: none; padding: 0; }
  .album-list li { margin-bottom: var(--spacing-md); font-size: 1.05rem; }
  .album-title { font-size: 1.35rem; }
  .rating { display: inline-block; margin-left: var(--spacing-sm); color: #d4a017; letter-spacing: 1px; }
  :global(.prose .fiche-link) { color: #7c3aed; font-size: 0.9em; }
  :global(.dark .prose .fiche-link) { color: #a78bfa; }
</style>
