---
import Base from "@app/layouts/Base.astro";
import type { Locale } from "@app/i18n/config";
import { t, localizedPath, resourceItemPath, formatFullDate } from "@app/i18n/utils";
import { render } from "astro:content";
import { fragmentsFor, ficheHeadline } from "@app/lib/fiche";

interface Props {
  fiche: any;
  locale?: Locale;
}

const { fiche, locale = "en" } = Astro.props;
const { Content } = await render(fiche);
const resourceUrl = resourceItemPath(locale, fiche.data.resource_collection, fiche.data.resource_id);

// Fragments live beside the fiche in the garden tree, not under src/content —
// a shared helper so the two themes cannot drift back to the stale path.
const fragments = fragmentsFor(fiche.id);
const head = ficheHeadline(fiche.data);
---

<Base title={fiche.data.title} locale={locale}>
  <article>
    <header>
      <p class="back-link"><a href={localizedPath(locale, "/fiches")}>{t(locale, "fiches.backToFiches")}</a></p>
      <h1 class="title">{fiche.data.title}</h1>
      {head.subtitle && <p class="subtitle">{head.subtitle}</p>}
      {(head.byline.length > 0 || head.when) && (
        <p class="byline">
          {head.byline.join(" · ")}
          {head.byline.length > 0 && head.when && <span class="text-muted"> · </span>}
          {head.when && <span class="text-muted">{head.when}</span>}
        </p>
      )}
      <p class="meta">
        <a href={resourceUrl} class="resource-link">{fiche.data.resource_collection} / {fiche.data.resource_id}</a>
        <span class="text-muted"> · {t(locale, "fiches.savedOn")} {formatFullDate(fiche.data.date, locale)}</span>
        {head.url && (
          <>
            <span class="text-muted"> · </span>
            <a href={head.url} class="source-link" rel="noopener" target="_blank">{head.host}</a>
          </>
        )}
      </p>
      {fiche.data.tags.length > 0 && (
        <p class="tags text-muted">{fiche.data.tags.join(", ")}</p>
      )}
    </header>

    {(head.summary || head.excerpt) && (
      <p class="summary">{head.summary || head.excerpt}</p>
    )}

    <div class="body-text">
      <Content />
      {fragments.map(f => (
        <details class="fragment">
          <summary class="fragment__summary">{f.summary}</summary>
          <div class="fragment__body" set:html={f.html} />
        </details>
      ))}
    </div>
  </article>
</Base>

<style>
  article {
    max-width: 65ch;
  }

  .back-link {
    margin-bottom: var(--spacing-sm);
  }

  header {
    margin-bottom: var(--spacing-xl);
  }

  .title {
    font-size: 3rem;
    font-weight: 600;
    margin-bottom: 0;
    line-height: 1.1;
  }

  .meta {
    margin-top: 0.5rem;
  }

  .resource-link {
    font-family: var(--font-mono, monospace);
    font-size: 0.875rem;
  }

  .tags {
    font-size: 0.875rem;
    margin-top: 0.25rem;
  }

  .subtitle {
    font-size: 1.25rem;
    line-height: 1.35;
    margin: 0.4rem 0 0;
    color: var(--color-text-quiet, inherit);
  }

  .byline {
    margin: 0.5rem 0 0;
    font-size: 0.95rem;
  }

  .source-link {
    font-family: var(--font-mono, monospace);
    font-size: 0.875rem;
  }

  /* The AI summary, or the source teaser until one exists. Set apart from the
     body, which is where the reader's own comment lives. */
  .summary {
    margin: 0 0 var(--spacing-lg);
    padding-left: 0.9rem;
    border-left: 2px solid var(--color-border);
    font-size: 1.02rem;
    line-height: 1.55;
    color: var(--color-text-quiet, inherit);
  }

  .body-text {
    margin-top: var(--spacing-lg);
  }

  .fragment {
    border-left: 2px solid var(--color-border);
    padding-left: 0.75rem;
    margin: 1rem 0;
  }
  .fragment__summary {
    cursor: pointer;
    font-weight: 600;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--color-text-quiet);
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.4em;
  }
  .fragment__summary::-webkit-details-marker { display: none; }
  .fragment__summary::before {
    content: "▸";
    display: inline-block;
    transition: transform 0.15s ease;
  }
  .fragment[open] > .fragment__summary::before {
    transform: rotate(90deg);
  }
  .fragment__body { margin-top: 0.5rem; }
</style>
