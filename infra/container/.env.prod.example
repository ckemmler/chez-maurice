# Copy to .env beside compose.prod.yml and fill in. Never commit the result.

# The name this instance answers to. Caddy gets a Let's Encrypt certificate for
# it, so it must already resolve (an A record) to this machine's IP.
MAURICE_DOMAIN=maurice.example.eu

# The image to run. Build it on a machine of the same architecture and push it:
#   docker compose -f compose.prod.yml build
#   docker tag maurice:production rg.fr-par.scw.cloud/<namespace>/maurice:<tag>
#   docker push rg.fr-par.scw.cloud/<namespace>/maurice:<tag>
MAURICE_IMAGE=maurice:production

MAURICE_TIMEZONE=Europe/Paris

# The model provider's key does NOT go here. It is a column on the households
# row, set from the admin dashboard once the instance is up:
#
#   https://<your domain>/admin  →  setup  →  settings
#
# Mint one for this instance rather than reusing a personal key: it lives in a
# database on a machine you do not physically hold, and it should be revocable
# on its own. The provider list is hardcoded in server/src/services/claude.ts
# (anthropic, openai, mistral, zai, scaleway, ollama) — adding another is a code change.

# Turns on OAuth for the MCP gateway, so Claude can add this server as a remote
# connector. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
MAURICE_OAUTH_PASSWORD=

# Where Maurice's documentation (the maurice_docs tool) refreshes from: the notes in
# docs/maurice/ on the repo's main branch, checked 20 s after boot and then
# daily, kept on the home volume. Leave unset for the public repo; `off` makes
# no outbound call and the tool answers from the image's snapshot.
# MAURICE_DOCS_URL=off

# ── Corpus (semantic search) ─────────────────────────────────────────────────
# There is no Ollama on a deployed instance, so embeddings come from an
# OpenAI-compatible endpoint. Scaleway Generative APIs keeps the whole chain in
# the EU, which is the point.
#
# CHANGING THE MODEL OR ITS DIMENSION INVALIDATES THE INDEX: vectors from two
# models are not comparable, the store refuses to open under another model, so
# a change means a full reindex. Decide at install time, while the index is
# still empty.
#
# Qwen3-Embedding 8B at 1024 dimensions is the default since 19 September 2026
# (matryoshka-truncated from 4096; the same shape of store as a Mac running the
# 0.6B). A key scoped to one Scaleway project must name it in the URL:
# https://api.scaleway.ai/<project id>/v1. Households installed earlier run
# bge-multilingual-gemma2 at 3584 and keep it.
CORPUS_EMBEDDING_BASE_URL=https://api.scaleway.ai/v1
CORPUS_EMBEDDING_MODEL=qwen3-embedding-8b
CORPUS_EMBEDDING_API_KEY=
CORPUS_EMBEDDING_DIM=1024
